{
  "name": "myvloggingstudio",
  "productName": "MyVloggingStudio",
  "version": "1.0.0",
  "description": "Editor de video de escritorio",
  "main": "main.js",
  "author": "MyVloggingStudio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win zip --x64",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.myvloggingstudio.app",
    "productName": "MyVloggingStudio",
    "files": [
      "main.js",
      "preload.js",
      "ui/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": "zip",
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}